{
  "provider": "provider-hub",
  "maxAttempts": 6,
  "cooldownMs": 30000,
  "sessionAffinity": true,
  "listen": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 19529,
    "apiKeyEnv": "DSH_PROVIDER_HUB_CLIENT_KEY"
  },
  "accountService": {
    "enabled": true,
    "autoInstall": true,
    "port": 19629,
    "priority": 1000
  },
  "routes": [
    {
      "id": "openai-official",
      "displayName": "OpenAI Official API",
      "baseURL": "https://api.openai.com/v1",
      "api": "openai-responses",
      "apiKeyEnv": "OPENAI_API_KEY",
      "priority": 500,
      "backup": false,
      "models": ["gpt-5.4"],
      "modelAliases": {},
      "headers": {}
    },
    {
      "id": "fallback-relay",
      "displayName": "Fallback OpenAI-compatible Relay",
      "baseURL": "https://relay.example/v1",
      "api": "openai-completions",
      "apiKeyEnv": "DSH_PROVIDER_HUB_FALLBACK_RELAY_KEY",
      "priority": 10,
      "backup": true,
      "models": ["gpt-5.4"],
      "modelAliases": {
        "gpt-5.4": "vendor-model-name"
      },
      "headers": {}
    }
  ]
}
