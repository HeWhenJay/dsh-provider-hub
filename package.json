{
  "name": "@hewhenjay/dsh-provider-hub",
  "version": "0.6.3",
  "description": "Native DSH provider hub with named API keys, per-key model allowlists, OAuth accounts, failover, and redacted logs",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./web-client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./config.example.json": "./config.example.json",
    "./routing": "./routing.js",
    "./sidecar": "./sidecar.js",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "routing.js", "sidecar.js", "web-client.js", "cordis.patch.yml", "config.example.json", "README.md", "LICENSE", "docs/images"],
  "license": "CC-BY-NC-SA-4.0",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-primitives",
        "react-dom"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeWhenJay/dsh-provider-hub.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "engines": { "node": ">=20" },
  "scripts": { "test": "node --test test/*.test.js" }
}
